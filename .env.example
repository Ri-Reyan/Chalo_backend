# Backend Environment Configuration (.env.example)

# ==============================================================================
# SERVER CONFIGURATION
# ==============================================================================
PORT=4000
NODE_ENV=development
CLIENT_URL=http://localhost:3000

# ==============================================================================
# DATABASE CONFIGURATION (PostgreSQL / Supabase)
# ==============================================================================
# Pooled connection string (Transaction mode pooler, IPv4 / pgbouncer)
DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Direct connection string (Used for Prisma schema migrations)
DIRECT_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres"

# ==============================================================================
# UPSTASH REDIS (Rate Limiting & Temporary Ride Caching)
# ==============================================================================
UPSTASH_REDIS_REST_URL="https://[YOUR_INSTANCE].upstash.io"
UPSTASH_REDIS_REST_TOKEN="your_upstash_redis_rest_token_here"

# ==============================================================================
# AUTHENTICATION & JWT (Access & Refresh Tokens)
# ==============================================================================
JWT_ACCESS_TOKEN="your_jwt_access_secret_min_32_chars"
JWT_REFRESH_TOKEN="your_jwt_refresh_secret_min_32_chars"
JWT_ACCESS_TOKEN_TIME="15m"
JWT_REFRESH_TOKEN_TIME="7d"

# ==============================================================================
# STRIPE PAYMENT INTEGRATION (Escrow, Checkout, & Refunds)
# ==============================================================================
STRIPE_SECRET_KEY="sk_test_your_stripe_secret_key"
STRIPE_PUBLISHABLE_KEY="pk_test_your_stripe_publishable_key"
